{
  "$schema": "https://static.modelcontextprotocol.io/schemas/mcp-server-card/v1.json",
  "version": "1.0",
  "protocolVersion": "2025-11-25",
  "serverInfo": {
    "name": "ARIFOS MCP",
    "title": "arifOS Constitutional MCP Server",
    "version": "kanon-2026.07.15"
  },
  "description": "Constitutional AI governance kernel. Public surface: 8 canonical tools (init → observe → think → route → memory → judge → forge → seal). F1-F13 floors enforced. VAULT999 immutable ledger. Streamable HTTP + stdio transports.",
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://mcp.arif-fazil.com/mcp",
    "stdio": {
      "command": "npx",
      "args": ["-y", "arifos-mcp"]
    }
  },
  "authentication": {
    "required": false,
    "schemes": ["bearer"],
    "description": "Arif_init, observe, think, route are open (no auth). Judge, forge, seal require session + authority verification. DPoP optional (observe mode default)."
  },
  "capabilities": {
    "tools": { "listChanged": true },
    "resources": { "subscribe": false, "listChanged": true },
    "prompts": { "listChanged": true }
  },
  "tools": [
    { "name": "arif_init" },
    { "name": "arif_observe" },
    { "name": "arif_think" },
    { "name": "arif_route" },
    { "name": "arif_memory" },
    { "name": "arif_judge" },
    { "name": "arif_forge" },
    { "name": "arif_seal" }
  ],
  "tool_count": 8,
  "homepage": "https://arifos.arif-fazil.com",
  "source_of_truth": "public_tool_names() == tools/list == server.py register_tools()",
  "chatgpt_compatible": true,
  "claude_desktop_compatible": true
}
