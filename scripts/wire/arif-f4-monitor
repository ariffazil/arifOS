#!/bin/bash
# arifOS F4 Runtime Monitor — state-driven entropy cap
# Detects reasoning loops via state hash comparison
# Auto-HOLD after 3 cycles with no state change
# DITEMPA BUKAN DIBERI

MAX_CYCLES=3
HASH_FILE="/var/run/arif_think_last_hash"
CYCLE_FILE="/var/run/arif_think_cycles"
LOG_FILE="/var/log/arifos_f4_monitor.log"
LOCK_FILE="/var/run/arif_think_f4_locked"

log() { echo "[$(date +%H:%M:%S)] $*" >> "$LOG_FILE" 2>/dev/null; }

read_cycles() { cat "$CYCLE_FILE" 2>/dev/null || echo 0; }
read_hash() { cat "$HASH_FILE" 2>/dev/null || echo ""; }
write_hash() { printf "%s" "$1" > "$HASH_FILE"; }
write_cycles() { printf "%s" "$1" > "$CYCLE_FILE"; }
is_locked() { [ -f "$LOCK_FILE" ]; }

case "${1:-check}" in
  check)
    if is_locked; then
      echo "🔒 [F4] CIRCUIT LOCKED — reasoning loop detected"
      echo "    Reset: rm -f $LOCK_FILE $CYCLE_FILE $HASH_FILE"
      exit 1
    fi

    STATE_HASH=$(md5sum /var/run/arifos_state.json 2>/dev/null | awk "{print \$1}" || echo "missing")
    PREV_HASH=$(read_hash)

    if [ "$STATE_HASH" = "$PREV_HASH" ]; then
      CYCLE=$(($(read_cycles) + 1))
      write_cycles "$CYCLE"
      log "CYCLE $CYCLE/$MAX_CYCLES — no state change (hash=$STATE_HASH)"

      if [ "$CYCLE" -ge "$MAX_CYCLES" ]; then
        log "F4 VIOLATION — max cycles reached. AUTO-HOLD."
        touch "$LOCK_FILE"
        degraded=$(cat /var/run/arifos_state.json 2>/dev/null | jq -r ".degraded_organs // \"unknown\"" 2>/dev/null)
        echo "🔒 [F4 VIOLATION] REASONING LOOP DETECTED. NO STATE CHANGE."
        echo "🔒 AUTO-HOLD INITIATED. ESCALATING TO 888 (SOVEREIGN)."
        echo "🔒 Target: $degraded"
        echo "🔒 Reset: rm -f $LOCK_FILE $CYCLE_FILE $HASH_FILE"
        exit 2
      else
        echo "⚠️ [F4] Cycle $CYCLE/$MAX_CYCLES — state unchanged"
        exit 0
      fi
    else
      # State changed — reset counter
      write_cycles "0"
      write_hash "$STATE_HASH"
      log "STATE CHANGE — hash updated, counter reset"
      echo "✅ [F4] State changed — counter reset"
      exit 0
    fi
    ;;

  reset|unlock)
    rm -f "$LOCK_FILE" "$CYCLE_FILE" "$HASH_FILE"
    log "MANUAL RESET — F4 monitor cleared"
    echo "✅ F4 monitor reset"
    ;;

  status)
    echo "═══ F4 Runtime Monitor ═══"
    echo "  Cycles:  $(read_cycles)/$MAX_CYCLES"
    echo "  Locked:  $(is_locked && echo YES || echo no)"
    echo "  Hash:    $(read_hash | cut -c1-12)..."
    echo "  Log:     $LOG_FILE"
    echo "  Enforce: arif-f4-monitor check"
    echo "  Reset:   arif-f4-monitor reset"
    ;;
esac
