{
  "mcpServers": {
    "arifOS": {
      "command": "npx",
      "args": ["-y", "arifos-mcp"],
      "env": {
        "ARIFOS_CHATGPT_COMPAT": "true",
        "ARIFOS_DPOP_MODE": "observe"
      },
      "disabled": false,
      "autoApprove": [
        "arif_init",
        "arif_observe",
        "arif_think",
        "arif_route",
        "arif_memory",
        "arif_canary"
      ],
      "alwaysAllow": []
    }
  }
}
