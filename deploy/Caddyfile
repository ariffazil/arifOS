		file_server
	}
	# Also serve static machine-readable article pages for non-JS clients
	# (RSS readers, search crawlers that don't identify as bots)
	@makcikgpt_nojs {
		path /world/makcikgpt/*
		not header_regexp Accept text/html
	}
