{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arifos://schema/audio.invoke/v2/input",
  "title": "audio.invoke — Input Schema (v2)",
  "description": "Provider-neutral MCP tool for governed audio analysis — v2 with multi-artifact fusion, streaming, and confidence floor controls.",
  "type": "object",
  "required": ["artifact_refs", "task"],
  "properties": {
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["uri", "expected_mime_type"],
        "properties": {
          "uri": { "type": "string" },
          "expected_mime_type": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "time_range": {
            "type": "object",
            "required": ["start_ms", "end_ms"],
            "properties": {
              "start_ms": { "type": "integer", "minimum": 0 },
              "end_ms": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "channel_selector": {
            "oneOf": [
              { "type": "string", "enum": ["all", "mono_mix"] },
              { "type": "array", "items": { "type": "integer", "minimum": 0 } }
            ]
          },
          "role_hint": {
            "type": "string",
            "enum": ["primary", "reference", "background", "comparison"],
            "default": "primary",
            "description": "v2 NEW — hints at the artifact's role in multi-artifact fusion."
          }
        },
        "additionalProperties": false
      }
    },
    "task": {
      "type": "string",
      "enum": [
        "transcribe",
        "classify",
        "diarize",
        "detect_events",
        "reason",
        "summarize",
        "translate",
        "compare",
        "quality_assess"
      ],
      "description": "v2 adds 'compare' (cross-artifact comparison) and 'quality_assess' (signal quality scoring)."
    },
    "language_hint": { "type": "string", "maxLength": 20 },
    "target_language": { "type": "string", "maxLength": 20 },
    "output_mode": {
      "type": "string",
      "enum": ["full", "summary", "segments_only", "structured_only", "streaming"],
      "default": "full",
      "description": "v2 adds 'streaming' for progressive SSE/NF output."
    },
    "risk_tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_latency_ms": { "type": "integer", "exclusiveMinimum": 0 },
        "external_provider": { "type": "string" },
        "retain_transcript": { "type": "boolean", "default": false },
        "redact_sensitive": { "type": "boolean", "default": false },
        "confidence_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.90,
          "default": 0.0,
          "description": "v2 NEW — minimum acceptable confidence. Segments below this threshold are flagged as low_confidence errors."
        },
        "provider_fallback_chain": {
          "type": "array",
          "items": { "type": "string" },
          "description": "v2 NEW — ordered fallback provider list. Overrides SOT default chain."
        }
      },
      "additionalProperties": false
    },
    "trace_id": { "type": "string", "pattern": "^[a-fA-F0-9]{32}$" },
    "dry_run": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
