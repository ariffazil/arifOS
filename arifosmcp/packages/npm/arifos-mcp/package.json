{
  "name": "@arifos/mcp",
  "version": "2026.11.22",
  "description": "Thin TypeScript/JavaScript MCP client for the arifOS governance kernel (PyPI: arifos). Mirrors the 9 live MCP wire tools (8 canonical verbs + arif_report) with zero client-side governance authority.",
  "keywords": [
    "mcp",
    "arifos",
    "ai-governance",
    "constitutional-ai",
    "model-context-protocol"
  ],
  "homepage": "https://arifos.arif-fazil.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ariffazil/arifOS.git",
    "directory": "arifosmcp/packages/npm/arifos-mcp"
  },
  "bugs": {
    "url": "https://github.com/ariffazil/arifOS/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "Muhammad Arif bin Fazil <arifos@arif-fazil.com>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.mjs",
      "require": "./dist/langchain.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/types.ts src/client.ts src/langchain.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
