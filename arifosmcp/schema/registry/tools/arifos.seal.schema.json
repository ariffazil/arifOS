    "judge_state_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "witness_type": {
      "default": "ai",
      "type": "string"
    },
    "drift_events": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": true,
            "type": "object"
