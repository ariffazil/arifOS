{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "333 Think · Mind",
  "description": "KERNEL 333 · Mind — structured reasoning under F2/F7 with OBS/DER/INT/SPEC labels.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "mode": {
      "default": "reason",
      "type": "string",
      "enum": [
        "reason",
        "reflect",
        "verify",
        "axioms",
        "plan",
        "plan_review",
        "plan_approve",
        "refactor_plan",
        "metabolize",
        "simulate",
        "wonder",
        "atlas"
      ]
    },
    "query": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "session_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "witness_type": {
      "default": "ai",
      "type": "string"
    },
    "context": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Background facts. Only role and handoff are read from context; pass typed evidence via the evidence parameter."
    },
    "evidence": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "D2 typed EvidenceObjects admitted into reasoning: {subject, claim, classification VERIFIED|DERIVED|REPORTED|UNKNOWN|CONTRADICTED, observed_at, expires_at, source_id, source_uri, observer_actor, observer_verified, contradictions, falsifier}. Expired entries are omitted; UNKNOWN/CONTRADICTED are gated from supporting PASS-shaped conclusions."
    },
    "_envelope": {
      "default": null,
      "title": "Envelope"
    }
  }
}
